generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  phone           String?
  address         String?
  city            String?
  businessNumber  String?
  taxId           String?
  notes           String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  offers    Offer[]
  posts     Post[]
  todoTasks TodoTask[]
  user      User?
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  clientId      Int
  status        String        @default("draft")
  issueDate     DateTime      @default(now())
  subtotal      Float         @default(0)
  tax           Float         @default(0)
  total         Float         @default(0)
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        Client        @relation(fields: [clientId], references: [id])
  items         InvoiceItem[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  category  String
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DomainReminder {
  id               Int      @id @default(autoincrement())
  domain           String   @unique
  provider         String?
  billingCycle     String   @default("yearly")
  amount           Float    @default(0)
  currency         String   @default("EUR")
  nextDueDate      DateTime
  remindDaysBefore Int      @default(7)
  autoRenew        Boolean  @default(true)
  status           String   @default("active")
  lastPaidDate     DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TodoTask {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  priority    String   @default("medium")
  status      String   @default("open")
  clientId    Int?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client?  @relation(fields: [clientId], references: [id])
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  content     String?
  platform    String
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  clientId    Int?
  imageUrl    String?
  tags        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  client      Client?   @relation(fields: [clientId], references: [id])
}

model Offer {
  id                   Int         @id @default(autoincrement())
  offerNumber          String      @unique
  title                String
  clientId             Int
  status               String      @default("draft")
  issueDate            DateTime    @default(now())
  validUntil           DateTime
  subtotal             Float       @default(0)
  tax                  Float       @default(0)
  total                Float       @default(0)
  notes                String?
  convertedToInvoiceId Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  client               Client      @relation(fields: [clientId], references: [id])
  items                OfferItem[]
}

model OfferItem {
  id          Int    @id @default(autoincrement())
  offerId     Int
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  offer       Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model Service {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  defaultPrice Float    @default(0)
  unit         String?  @default("copë")
  price1h      Float?
  price2to5h   Float?
  price5to8h   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CompanySettings {
  id            Int      @id @default(autoincrement())
  name          String   @default("AXEmedia")
  tagline       String   @default("Agjensi Marketingu & Dizajni")
  address       String   @default("Tiranë, Shqipëri")
  phone         String   @default("+355 69 000 0000")
  email         String   @default("info@axemedia.al")
  taxId         String   @default("")
  website       String   @default("www.axemedia.al")
  bankAccount   String   @default("")
  swiftCode     String   @default("")
  logoUrl       String   @default("")
  stampUrl      String   @default("")
  stampSize     Int      @default(55)
  stampPosX     Int      @default(0)
  stampPosY     Int      @default(0)
  stampRotate   Int      @default(0)
  signatureUrl  String   @default("")
  invoiceFooter String   @default("Faleminderit për bashkëpunimin!")
  offerFooter   String   @default("Kjo ofertë nuk është faturë. Pagesa nuk kërkohet deri pas konfirmimit.")
  logoSize      Int      @default(22)
  primaryColor  String   @default("#009ec6")
  fontFamily    String   @default("helvetica")
  domainInvoiceLogoUrl       String   @default("")
  domainInvoiceBackgroundUrl String   @default("")
  updatedAt     DateTime @updatedAt
}

model DomainInvoice {
  id                 Int      @id @default(autoincrement())
  invoiceNumber      String
  issueDate          DateTime
  status             String   @default("unpaid")
  customer           String   @default("")
  customerEmail      String   @default("")
  providerName       String   @default("")
  serviceType        String   @default("hosting")
  domainName         String   @default("")
  service            String   @default("")
  period             String   @default("")
  quantity           Float    @default(1)
  amount             Float    @default(0)
  taxRate            Float    @default(0)
  currency           String   @default("EUR")
  notes              String   @default("")
  mainColor          String   @default("#06B6D4")
  businessName       String   @default("")
  businessAddress    String   @default("")
  businessEmail      String   @default("")
  businessPhone      String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("staff")
  clientId  Int?     @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?  @relation(fields: [clientId], references: [id])
}
